{
  "name": "examforge-mcp-server",
  "version": "0.1.0",
  "description": "ExamForge MCP Server - lets any MCP-capable Agent render review content, generate quizzes, and collect answers in the user's browser.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "moereview": "dist/index.js",
    "examforge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "hub": "node dist/hub.js",
    "dev:hub": "tsx watch src/hub.ts",
    "dev": "tsx watch src/index.ts",
    "spike": "tsx src/spike-test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.2.0",
    "pdf-parse": "^2.4.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
